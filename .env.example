# .env.example - copy to .env and fill values (DO NOT commit .env with real keys)
# API keys for LLM providers and agent operation

# Groq (optional)
GROQ_API_KEY=

# Google Gemini (optional)
GEMINI_API_KEY=

# DeepSeek (optional)
DEEPSEEK_API_KEY=

# OpenRouter (used by agent fallbacks, recommended)
OPENROUTER_API_KEY=

# Optional: timeout override for OpenHands agent (seconds)
OPENHANDS_TIMEOUT=60

# Any other environment settings your local run may require:
# E.g., database connection strings for chat storage if you move DB, etc.